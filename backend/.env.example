NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_ACCESS=7d

# MySQL connection details from Aiven.
DB_TYPE=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Enable TLS for Aiven and paste its CA certificate, including PEM begin/end lines.
DB_SSL=true
DB_SSL_CA=

# Set true once to create the initial schema, then set false.
DB_SYNCHRONIZE=false

# Netlify site origin; use localhost while developing.
CORS_ORIGIN=http://localhost:5173

