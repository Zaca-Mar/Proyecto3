# Copiá este archivo como .env y completá la conexión a MySQL local.
# El archivo .env no se sube a Git.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=12345
DB_DATABASE=fittracker
DB_SYNCHRONIZE=true
DB_SSL=false

JWT_SECRET=cambia_esta_clave_por_al_menos_32_caracteres_aleatorios
JWT_EXPIRATION_ACCESS=7d
